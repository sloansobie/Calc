{
  "name": "scientific-calculator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "preview": "vite preview --host 127.0.0.1",
    "format:check": "prettier --check src vite.config.ts package.json tsconfig.json index.html",
    "desktop:build": "sh scripts/build-macos.sh"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "mathjs": "^14.8.1",
    "mathlive": "^0.109.0",
    "nerdamer": "1.1.13",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.25.0"
}
